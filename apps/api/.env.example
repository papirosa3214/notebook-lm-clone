# Copy to apps/api/.env and fill in real values.
# NEVER commit the real .env (see .gitignore).

NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# LLM providers — at least one required for chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://192.168.1.110:11434

# Embeddings — used by the local vector store (Ollama bge-m3-embed, 1024-dim)
EMBEDDING_BASE_URL=http://192.168.1.110:11434
EMBEDDING_MODEL=bge-m3-embed
EMBEDDING_DIM=1024

# Local SQLite path (relative to apps/api)
DB_PATH=./data/notebook.db

# --- YouTube → ASR (local Whisper) --------------------------------------
# Used by the «YouTube → ASR» source button when youtube-transcript cannot
# pull captions (login wall, region-locked, author disabled subs). Requires
#   - `yt-dlp` on PATH (`brew install yt-dlp`)
#   - `ffmpeg` on PATH (`brew install ffmpeg`)
#   - whisper.cpp `--server` running at WHISPER_BASE_URL/inference
#     (e.g. https://github.com/ggerganov/whisper.cpp/tree/master/examples/server)
WHISPER_BASE_URL=http://127.0.0.1:8000
WHISPER_LANGUAGE=ru

# Optional: path to a Netscape-format cookies.txt for yt-dlp. Required for
# videos that ask YouTube to confirm "you're not a bot". Export from your
# browser via "Get cookies.txt LOCALLY" while logged in.
# YT_COOKIES_PATH=/absolute/path/to/youtube-cookies.txt

# --- Rerank provider ----------------------------------------------------
# Pluggable: swap the slow LLM-rerank for a TEI cross-encoder without
# touching code. See apps/api/src/lib/rerank/ for the implementations.
#
#   llm  (default) — uses the chat LLM (qwen3.6 / Haiku / …) to score
#                    each candidate 0-10. ~2-6 s per chat turn.
#   http           — POST /rerank to RERANK_HTTP_URL. TEI / FlagEmbedding
#                    / Infinity all follow this contract; bge-reranker-v2-m3
#                    is the typical model. ~300 ms per call.
#   noop           — pass-through, only RRF merge (dense + BM25).
# RERANK_PROVIDER=llm
# RERANK_HTTP_URL=http://192.168.1.110:8001
# RERANK_HTTP_MODEL=bge-reranker-v2-m3
# RERANK_TIMEOUT_MS=30000