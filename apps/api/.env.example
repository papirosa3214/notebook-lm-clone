# Copy to apps/api/.env and fill in real values.
# NEVER commit the real .env (see .gitignore).

NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# LLM providers — at least one required for chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://192.168.1.110:11434

# Embeddings — used by the local vector store (Ollama bge-m3-embed, 1024-dim)
EMBEDDING_BASE_URL=http://192.168.1.110:11434
EMBEDDING_MODEL=bge-m3-embed
EMBEDDING_DIM=1024

# Local SQLite path (relative to apps/api)
DB_PATH=./data/notebook.db